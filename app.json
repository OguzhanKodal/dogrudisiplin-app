{
  "expo": {
    "name": "Doğru Disiplin",
    "slug": "dogrudisiplin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dogrudisiplin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.kodal.dogrudisiplin",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C8F031",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.kodal.dogrudisiplin",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14181F",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#14181F"
  }
}